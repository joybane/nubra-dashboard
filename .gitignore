# Dependencies
node_modules/

# Build output
dist/

# SQLite runtime files
*.db
*.db-wal
*.db-shm

# Environment
.env
.env.local

# Broker session material. These hold a live auth token, deviceId, salt and phone number —
# the same standing as .env, which is why they sit beside it. They were tracked until
# 2026-08-14; `git rm --cached` untracked them, but every commit before that still contains
# them, so the credentials themselves must be rotated rather than merely un-listed here.
session.json
uat-session.json

# OS
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/

# Archived one-off patch scripts / backups / logs (kept locally, not tracked)
_archive/

# Per-date instrument masters, re-downloadable from the broker (see backtestRefdataStore.ts)
.refdata-cache/
# Today's instrument master, so a restart does not re-download it (see refdataCache.ts)
.refdata-live/

# Per-date historical bars, re-downloadable from the broker (see backtestBarStore.ts)
.bars-cache/

# Runtime logs & editor scratch files
*.log
*.bak
*.tmp
*.tmp.*
StrategyAnalysisView.tsx.*
