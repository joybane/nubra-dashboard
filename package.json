{
  "name": "nubra-dashboard",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -n \"server,vite\" -c \"cyan,green\" \"node --experimental-strip-types server/index.ts\" \"vite --port 8000\"",
    "dev": "vite --port 8000",
    "build": "tsc -b && vite build",
    "server": "node --experimental-strip-types server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.server.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "fastify": "^5.3.2",
    "hyparquet": "^1.26.1",
    "hyparquet-compressors": "^1.1.1",
    "lightweight-charts": "^5.0.0",
    "protobufjs": "^8.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-window": "^1.8.10",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-window": "^1.8.8",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "daisyui": "^4.12.24",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.7.0",
    "playwright": "^1.61.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
