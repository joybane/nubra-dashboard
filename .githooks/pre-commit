#!/bin/sh
# Pre-commit gate: the same checks the project already defines, run before every commit so
# formatting drift, type errors and broken tests stop at the door instead of piling up.
# About 25 s. Skip once, deliberately, with:  git commit --no-verify
#
# Enabled per clone by `npm install` (the "prepare" script sets core.hooksPath to .githooks).

cd "$(git rev-parse --show-toplevel)" || exit 1

# The tools are run through node directly. npm and npx are bash scripts on Windows, and the git
# that GitHub Desktop ships has sh but no bash, so calling them stops the commit with
# "/usr/bin/env: 'bash': No such file or directory".
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not on PATH here; skipping the gate." >&2
  exit 0
fi
if [ ! -f node_modules/prettier/bin/prettier.cjs ]; then
  echo "pre-commit: node_modules missing (run npm install); skipping the gate." >&2
  exit 0
fi
bin=node_modules

# Staged files the format/lint gates cover (git pathspec '*' also matches across folders).
staged=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.ts' 'src/*.tsx' 'src/*.css' 'server/*.ts')
lintable=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx)$')

fail() {
  echo "" >&2
  echo "pre-commit: $1 failed - commit stopped. Fix it, or bypass once with: git commit --no-verify" >&2
  exit 1
}

if [ -n "$staged" ]; then
  echo "pre-commit: prettier (staged files)"
  # shellcheck disable=SC2086
  node $bin/prettier/bin/prettier.cjs --check $staged || fail "formatting (run: npm run format)"
fi

if [ -n "$lintable" ]; then
  echo "pre-commit: eslint (staged files, errors only)"
  # shellcheck disable=SC2086
  node $bin/eslint/bin/eslint.js --quiet $lintable || fail "lint"
fi

echo "pre-commit: typecheck"
{ node $bin/typescript/bin/tsc -b && node $bin/typescript/bin/tsc --noEmit -p tsconfig.server.json; } || fail "typecheck"

echo "pre-commit: tests"
node $bin/vitest/vitest.mjs run --reporter=dot || fail "tests"
